{
  "name": "minicloud-suite",
  "version": "2.0.0",
  "private": true,
  "description": "MiniCloud — a microservices file-cloud SaaS suite (Notes, Gallery, Vault, Bookmarks) sharing one VPS storage volume",
  "scripts": {
    "start": "bash start.sh",
    "pm2": "pm2 start ecosystem.config.js",
    "stop": "pm2 delete ecosystem.config.js",
    "seed": "node scripts/seed-admin.js",
    "test": "node --test",
    "build:app": "cd frontend && npm install && npm run build"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1"
  }
}
